{
  "type": "record",
  "name": "LoginEvent",
  "namespace": "io.streamnative.demo.security",
  "fields": [
    {"name":"event_id","type":"string"},
    {"name":"event_type","type":"string"},
    {"name":"event_time","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"ingested_at","type":{"type":"long","logicalType":"timestamp-millis"}},
    {"name":"schema_version","type":"string"},
    {"name":"tenant_id","type":"string"},
    {"name":"scenario_id","type":"string"},
    {"name":"account_id","type":"string"},
    {"name":"session_id","type":"string"},
    {"name":"device_id","type":"string"},
    {"name":"ip_address","type":"string"},
    {"name":"country","type":"string"},
    {"name":"region","type":"string"},
    {"name":"city","type":"string"},
    {"name":"latitude","type":"double"},
    {"name":"longitude","type":"double"},
    {"name":"result","type":"string"},
    {"name":"auth_method","type":"string"},
    {"name":"failure_reason","type":["null","string"],"default":null},
    {"name":"user_agent","type":"string"}
  ]
}
